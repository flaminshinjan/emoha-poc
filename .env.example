# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Voice stack ---
DEEPGRAM_API_KEY=...
CARTESIA_API_KEY=...
# Cartesia voice id — pick a warm, mature female voice for the nurturing tone
CARTESIA_VOICE_ID=79a125e8-cd45-4c13-8a67-188112f4dd22
# Optional — overrides CARTESIA_VOICE_ID at runtime when a cloned voice is selected
CARTESIA_CLONED_VOICE_ID=

# --- Avatar (Tavus) ---
TAVUS_API_KEY=...
TAVUS_REPLICA_ID=...           # the avatar (face) you want to use
TAVUS_PERSONA_ID=               # optional — Tavus persona that owns the replica

# --- Pipecat WebRTC transport (Daily) ---
DAILY_API_KEY=...
DAILY_ROOM_URL=https://your-subdomain.daily.co/emoha-demo

# --- Bland.ai ---
BLAND_API_KEY=...
BLAND_PHONE_NUMBER=+91...
# Bland calls this base URL for tool fulfillment + pathway hops
BLAND_WEBHOOK_BASE=https://your-host.example.com

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=INFO
